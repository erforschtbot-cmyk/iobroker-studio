<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ioBroker Studio</AssemblyName>
    <RootNamespace>IoBrokerTool</RootNamespace>
    <Version>1.2.39</Version>
    <Authors>Elzershark</Authors>
    <Product>ioBroker Studio</Product>
    <Description>Professional desktop toolkit for ioBroker maintenance.</Description>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="AvaloniaTerminal" Version="1.0.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="../../Programm/Programm/backup-create.txt"
                      Link="Scripts/backup-create.sh"
                      LogicalName="IoBrokerTool.Scripts.backup-create.sh" />
    <EmbeddedResource Include="../../Programm/Programm/backup-restore.txt"
                      Link="Scripts/backup-restore.sh"
                      LogicalName="IoBrokerTool.Scripts.backup-restore.sh" />
    <EmbeddedResource Include="../../Programm/Programm/checkpoint-create.txt"
                      Link="Scripts/checkpoint-create.sh"
                      LogicalName="IoBrokerTool.Scripts.checkpoint-create.sh" />
    <EmbeddedResource Include="../../Programm/Programm/checkpoint-restore.txt"
                      Link="Scripts/checkpoint-restore.sh"
                      LogicalName="IoBrokerTool.Scripts.checkpoint-restore.sh" />
    <EmbeddedResource Include="../../Programm/Programm/checkpoint-export.txt"
                      Link="Scripts/checkpoint-export.sh"
                      LogicalName="IoBrokerTool.Scripts.checkpoint-export.sh" />
    <EmbeddedResource Include="../../Programm/Programm/repair.txt"
                      Link="Scripts/repair.sh"
                      LogicalName="IoBrokerTool.Scripts.repair.sh" />
    <EmbeddedResource Include="../../Programm/Programm/error-diagnostics.txt"
                      Link="Scripts/error-diagnostics.sh"
                      LogicalName="IoBrokerTool.Scripts.error-diagnostics.sh" />
    <EmbeddedResource Include="../../Programm/Programm/iobroker-install.txt"
                      Link="Scripts/iobroker-install.sh"
                      LogicalName="IoBrokerTool.Scripts.iobroker-install.sh" />
  </ItemGroup>
</Project>
